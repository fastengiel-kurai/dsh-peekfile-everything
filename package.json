{
  "name": "@kurai/dsh-peekfile-everything",
  "version": "0.1.0",
  "description": "DSH local file search, link detection, and floating preview plugin powered optionally by EverythingCLI.",
  "type": "module",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-slots"],
      "platform": "web"
    }
  },
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "everything",
    "file-preview"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "test": "node --test tests/*.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "files": ["lib", "src", "cordis.patch.yml", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "https://github.com/fastengiel-kurai/dsh-peekfile-everything.git"
  }
}
